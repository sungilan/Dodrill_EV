  - m_Id: 7925327091810304
    m_Localized: "\uD0D1\uC2B9\uC790\uC758 \uC2B9\uD558\uCC28\uB97C \uB3D5\uACE0
      \uCE21\uBA74 \uCDA9\uB3CC\uB85C\uBD80\uD130 \uBCF4\uD638\uD558\uB294 \uCC28\uB7C9
      \uBB38\uC785\uB2C8\uB2E4."
