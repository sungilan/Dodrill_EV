  - m_Id: 7926137070632960
    m_Localized: "\uCC28\uB7C9\uC758 \uD558\uC911\uC744 \uC9C0\uC9C0\uD558\uACE0
      \uAD6C\uB3D9\uB825\uACFC \uC81C\uB3D9\uB825\uC744 \uB178\uBA74\uC5D0 \uC9C1\uC811
      \uC804\uB2EC\uD558\uB294 \uBD80\uD488\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000001
    m_Localized: "\uC808\uC5F0 \uC7A5\uAC11"
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000002
    m_Localized: "\uACE0\uC804\uC555 \uC791\uC5C5 \uC2DC \uAC10\uC804\uC744 \uBC29\uC9C0\uD558\uAE30
      \uC704\uD574 \uCC29\uC6A9\uD558\uB294 \uC808\uC5F0 \uC18C\uC7AC\uC758 \uBCF4\uD638
      \uC7A5\uAC11\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000003
    m_Localized: "GDS \uD0DC\uBE14\uB9BF"
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000004
    m_Localized: "\uCC28\uB7C9 \uC9C4\uB2E8 \uC2DC\uC2A4\uD15C(GDS)\uC774 \uD0D1\uC7AC\uB41C
      \uD0DC\uBE14\uB9BF\uC73C\uB85C \uCC28\uB7C9\uC758 \uACE0\uC7A5 \uCF54\uB4DC
      \uBC0F \uC0C1\uD0DC\uB97C \uC9C4\uB2E8\uD558\uB294 \uB370 \uC0AC\uC6A9\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000005
    m_Localized: "\uC784\uD329\uD2B8 \uB80C\uCE58"
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000006
    m_Localized: "\uAC15\uD55C \uCDA9\uACA9 \uD1A0\uD06C\uB97C \uC774\uC6A9\uD574
      \uBCFC\uD2B8\uC640 \uB108\uD2B8\uB97C \uBE60\uB974\uAC8C \uC870\uC774\uAC70\uB098
      \uD480 \uC218 \uC788\uB294 \uC804\uB3D9 \uACF5\uAD6C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000007
    m_Localized: "\uC7A0\uAE08 \uBC15\uC2A4"
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000008
    m_Localized: "\uACE0\uC804\uC555 \uBC30\uD130\uB9AC \uC11C\uBE44\uC2A4 \uD50C\uB7EC\uADF8
      \uB4F1 \uC704\uD5D8 \uBD80\uD488\uC758 \uBB34\uB2E8 \uC870\uC791\uC744 \uBC29\uC9C0\uD558\uAE30
      \uC704\uD574 \uC0AC\uC6A9\uD558\uB294 \uC548\uC804 \uC7A0\uAE08 \uC7A5\uCE58\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000009
    m_Localized: "\uBA40\uD2F0\uBBF8\uD130"
    m_Metadata:
      m_Items: []
  - m_Id: 8341724762554368
    m_Localized: "\uC804\uC555 \uC804\uB958 \uC800\uD56D \uB4F1 \uC804\uAE30\uC801
      \uD2B9\uC131\uC744 \uCE21\uC815\uD558\uB294 \uACC4\uCE21 \uC7A5\uBE44\uB85C"
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000011
    m_Localized: "\uC2A4\uB9C8\uD2B8 \uD0A4"
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000012
    m_Localized: "\uBB34\uC120 \uC2E0\uD638\uB97C \uD1B5\uD574 \uCC28\uB7C9\uC758
      \uC7A0\uAE08 \uD574\uC81C, \uC2DC\uB3D9, \uB3C4\uC5B4 \uAC1C\uD3D0 \uB4F1\uC744
      \uC81C\uC5B4\uD558\uB294 \uC804\uC790\uC2DD \uCC28\uB7C9 \uD0A4\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000013
    m_Localized: "\uC548\uBA74 \uBCF4\uD638\uAD6C"
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000014
    m_Localized: "\uACE0\uC804\uC555 \uC791\uC5C5 \uB610\uB294 \uD654\uD559\uBB3C\uC9C8
      \uCDE8\uAE09 \uC2DC \uC5BC\uAD74 \uC804\uCCB4\uB97C \uBCF4\uD638\uD558\uAE30
      \uC704\uD574 \uCC29\uC6A9\uD558\uB294 \uD22C\uBA85 \uC548\uBA74 \uBCF4\uD638
      \uC7A5\uBE44\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000015
    m_Localized: "\uC808\uC5F0 \uC548\uC804\uD654"
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000016
    m_Localized: "\uAC10\uC804 \uC704\uD5D8\uC774 \uC788\uB294 \uC791\uC5C5 \uD658\uACBD\uC5D0\uC11C
      \uBC1C\uC744 \uBCF4\uD638\uD558\uB294 \uC808\uC5F0 \uC18C\uC7AC\uC758 \uC548\uC804\uD654\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000017
    m_Localized: "\uBCF4\uC548\uACBD"
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000018
    m_Localized: "\uC791\uC5C5 \uC911 \uBC1C\uC0DD\uD560 \uC218 \uC788\uB294 \uD30C\uD3B8,
      \uBD84\uC9C4, \uD654\uD559\uBB3C\uC9C8\uB85C\uBD80\uD130 \uB208\uC744 \uBCF4\uD638\uD558\uB294
      \uD22C\uBA85 \uBCF4\uD638 \uC548\uACBD\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 8487426867777536
    m_Localized: "\uC11C\uBE44\uC2A4 \uD50C\uB7EC\uADF8 (MSD)"
    m_Metadata:
      m_Items: []
  - m_Id: 8487431699615744
    m_Localized: "\uC11C\uBE44\uC2A4 \uD50C\uB7EC\uADF8(MSD)\uB294 \uC804\uAE30\uCC28\uC758
      \uACE0\uC804\uC555 \uBC30\uD130\uB9AC\uC640 \uB098\uBA38\uC9C0 \uD68C\uB85C\uB97C
      \uBB3C\uB9AC\uC801\uC73C\uB85C \uCC28\uB2E8\uD558\uB294 \uC548\uC804 \uC7A5\uCE58\uC785\uB2C8\uB2E4.
      \uC815\uBE44 \uC791\uC5C5 \uC911 \uC791\uC5C5\uC790\uB97C \uAC10\uC804 \uC0AC\uACE0\uB85C\uBD80\uD130
      \uBCF4\uD638\uD558\uAE30 \uC704\uD574 \uC0AC\uC6A9\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 12729850524155904
    m_Localized: "\uC2A4\uB9C8\uD2B8\uD0A4\uB97C \uC7A0\uAE08\uBC15\uC2A4\uC5D0 \uB123\uC5B4\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 12917184314032128
    m_Localized: "GDS \uC9C4\uB2E8\uAE30\uB97C OBD \uD3EC\uD2B8\uC5D0 \uAF42\uC544\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
