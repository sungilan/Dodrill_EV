  - m_Id: 7892727824465920
    m_Localized: "\uD6C4\uB95C \uAD6C\uB3D9 \uBAA8\uD130"
    m_Metadata:
      m_Items: []
  - m_Id: 7892741581783040
    m_Localized: "\uD6C4\uBC29 \uC804\uB825 \uBD84\uBC30 \uC720\uB2DB"
    m_Metadata:
      m_Items: []
  - m_Id: 7892769801060352
    m_Localized: "\uD6C4\uB95C \uC11C\uC2A4\uD39C\uC158"
    m_Metadata:
      m_Items: []
  - m_Id: 7892789027749888
    m_Localized: "\uC2DC\uD2B8"
    m_Metadata:
      m_Items: []
  - m_Id: 7892803586179072
    m_Localized: "\uC2A4\uD2F0\uC5B4\uB9C1 \uCEEC\uB7FC"
    m_Metadata:
      m_Items: []
  - m_Id: 7892822175334400
    m_Localized: "\uBE0C\uB808\uC774\uD06C \uC2DC\uC2A4\uD15C"
    m_Metadata:
      m_Items: []
  - m_Id: 7892839640416256
    m_Localized: "\uCC28\uB7C9 \uB3C4\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 7896409349636096
    m_Localized: "\uCC28\uB7C9\uC758 \uD558\uC911\uC744 \uC9C0\uC9C0\uD558\uACE0
      \uAD6C\uB3D9\uB825\uACFC \uC81C\uB3D9\uB825\uC744 \uB178\uBA74\uC5D0 \uC9C1\uC811
      \uC804\uB2EC\uD558\uB294 \uBD80\uD488\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 716533395017728
    m_Localized: "12V \uBCF4\uC870 \uBC30\uD130\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 7892341214494720
    m_Localized: "\uCDA9\uC804 \uD3EC\uD2B8"
    m_Metadata:
      m_Items: []
  - m_Id: 7892506000310272
    m_Localized: "\uB0C9\uAC01/\uACF5\uC870 \uC2DC\uC2A4\uD15C"
    m_Metadata:
      m_Items: []
  - m_Id: 7892579811672064
    m_Localized: "\uC804\uB95C \uAD6C\uB3D9 \uBAA8\uD130"
    m_Metadata:
      m_Items: []
  - m_Id: 7892606323867648
    m_Localized: "\uC804\uB95C \uC11C\uC2A4\uD39C\uC158"
    m_Metadata:
      m_Items: []
  - m_Id: 7892633498763264
    m_Localized: "\uD504\uB801\uD06C"
    m_Metadata:
      m_Items: []
  - m_Id: 7892656382885888
    m_Localized: "\uAC10\uC18D\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 7909806564786176
    m_Localized: "\uD0D1\uC2B9\uC790\uC758 \uC2B9\uD558\uCC28\uB97C \uB3D5\uACE0
      \uCE21\uBA74 \uCDA9\uB3CC\uB85C\uBD80\uD130 \uBCF4\uD638\uD558\uB294 \uCC28\uB7C9
      \uBB38\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7910093115441152
    m_Localized: "\uC8FC\uD589 \uC911\uC778 \uCC28\uB7C9\uC758 \uC18D\uB3C4\uB97C
      \uAC10\uC18D\uD558\uAC70\uB098 \uC815\uC9C0\uC2DC\uD0A4\uB294 \uC81C\uB3D9
      \uC7A5\uCE58\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7910223939977216
    m_Localized: "\uC6B4\uC804\uB300\uC758 \uC870\uD5A5\uB825\uC744 \uAE30\uC5B4\uBC15\uC2A4\uC640
      \uBC14\uD034\uB85C \uC804\uB2EC\uD558\uB294 \uC870\uD5A5 \uC7A5\uCE58 \uD575\uC2EC
      \uBD80\uD488\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7910504861876224
    m_Localized: "\uAE30\uC874 \uB0B4\uC5F0\uAE30\uAD00\uC758 \uC5D4\uC9C4\uB8F8
      \uACF5\uAC04\uC744 \uD65C\uC6A9\uD558\uC5EC \uB9CC\uB4E0 \uC804\uAE30\uCC28
      \uD2B9\uC720\uC758 \uC804\uBA74 \uC801\uC7AC \uACF5\uAC04\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7910571366760448
    m_Localized: "\uAD6C\uB3D9 \uBAA8\uD130\uC758 \uB192\uC740 \uD68C\uC804\uC218\uB97C
      \uB0AE\uCDB0 \uD798(\uD1A0\uD06C)\uC744 \uC99D\uB300\uC2DC\uD0A4\uACE0 \uBC14\uD034\uB85C
      \uB3D9\uB825\uC744 \uC804\uB2EC\uD558\uB294 \uC7A5\uCE58\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7910642338578432
    m_Localized: "\uC55E\uBC14\uD034\uAC00 \uBC1B\uB294 \uB178\uBA74\uC758 \uCDA9\uACA9\uC744
      \uD761\uC218\uD558\uC5EC \uC2B9\uCC28\uAC10\uACFC \uC870\uD5A5 \uC548\uC815\uC131\uC744
      \uB192\uC5EC\uC8FC\uB294 \uC7A5\uCE58\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7911262181212160
    m_Localized: "\uC804\uAE30\uC5D0\uB108\uC9C0\uB97C \uAE30\uACC4\uC801 \uC5D0\uB108\uC9C0\uB85C
      \uBCC0\uD658\uD558\uC5EC \uC55E\uBC14\uD034\uC5D0 \uAD6C\uB3D9\uB825\uC744
      \uBC1C\uC0DD\uC2DC\uD0A4\uB294 \uD575\uC2EC \uBAA8\uD130\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7911390669520896
    m_Localized: "\uACE0\uC804\uC555 \uBC30\uD130\uB9AC\uC640 \uBAA8\uD130\uC758
      \uC5F4\uC744 \uAD00\uB9AC\uD558\uACE0 \uC2E4\uB0B4 \uC628\uB3C4\uB97C \uC870\uC808\uD558\uB294
      \uD1B5\uD569 \uC81C\uC5B4 \uC7A5\uCE58\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7911842744188928
    m_Localized: "\uCC28\uB7C9 \uC804\uBA74\uBD80\uC758 \uC5D4\uC9C4\uB8F8(\uB610\uB294
      \uD504\uB801\uD06C)\uC744 \uB36E\uC5B4 \uB0B4\uBD80 \uBD80\uD488\uC744 \uBCF4\uD638\uD558\uB294
      \uAC1C\uD3D0\uD615 \uB36E\uAC1C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7911934079352832
    m_Localized: "\uCC28\uB7C9 \uD6C4\uBA74\uC5D0 \uC704\uCE58\uD558\uC5EC \uB4B7\uBC14\uD034\uC5D0
      \uC9C1\uC811\uC801\uC778 \uAD6C\uB3D9\uB825\uC744 \uC804\uB2EC\uD558\uB294
      \uACE0\uC804\uC555 \uAD6C\uB3D9 \uBAA8\uD130\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7912243153420288
    m_Localized: "\uB4B7\uBC14\uD034\uC758 \uB178\uBA74 \uCDA9\uACA9\uC744 \uD761\uC218\uD558\uACE0
      \uCC28\uCCB4 \uC218\uD3C9\uC744 \uC720\uC9C0\uD558\uC5EC \uC8FC\uD589 \uC548\uC815\uC131\uC744
      \uC81C\uACF5\uD558\uB294 \uC7A5\uCE58\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7912492253134848
    m_Localized: "\uD0D1\uC2B9\uC790\uAC00 \uC548\uC804\uD558\uACE0 \uD3B8\uC548\uD558\uAC8C
      \uC2B9\uCC28\uD560 \uC218 \uC788\uB3C4\uB85D \uC124\uACC4\uB41C \uCC28\uB7C9
      \uB0B4\uBD80 \uC88C\uC11D\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7913088951599104
    m_Localized: "\uCC28\uB7C9\uC758 \uC804\uC7A5 \uC2DC\uC2A4\uD15C(\uC870\uBA85,
      \uC778\uD3EC\uD14C\uC778\uBA3C\uD2B8, \uC81C\uC5B4 \uBAA8\uB4C8 \uB4F1)\uC5D0
      \uC804\uB825\uC744 \uACF5\uAE09\uD558\uBA70, \uACE0\uC804\uC555 \uC2DC\uC2A4\uD15C\uC744
      \uAC00\uB3D9\uD558\uAE30 \uC704\uD55C \uB9B4\uB808\uC774 \uC791\uB3D9 \uC804\uC6D0\uC744
      \uC81C\uACF5\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7913846019276800
    m_Localized: "\uCC28\uB7C9 \uAD6C\uB3D9\uC5D0 \uD544\uC694\uD55C \uB300\uC6A9\uB7C9
      \uC804\uAE30\uC5D0\uB108\uC9C0\uB97C \uC800\uC7A5\uD558\uBA70, \uC218\uB9CE\uC740
      \uBC30\uD130\uB9AC \uC140\uACFC \uAD00\uB9AC \uC2DC\uC2A4\uD15C(BMS)\uC73C\uB85C
      \uAD6C\uC131\uB41C \uD575\uC2EC \uBD80\uD488\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7913945499779072
    m_Localized: "\uC678\uBD80 \uCDA9\uC804\uAE30 \uCEE4\uB125\uD130\uB97C \uC5F0\uACB0\uD558\uC5EC
      \uACE0\uC804\uC555 \uBC30\uD130\uB9AC\uB97C \uCDA9\uC804\uD558\uAE30 \uC704\uD55C
      \uC785\uAD6C \uC7A5\uCE58\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7918957072302080
    m_Localized: "\uACE0\uC804\uC555 \uBC30\uD130\uB9AC \uD329"
    m_Metadata:
      m_Items: []
  - m_Id: 7918957072302081
    m_Localized: "\uC100\uC2DC \uD504\uB808\uC784"
    m_Metadata:
      m_Items: []
  - m_Id: 7918957072302082
    m_Localized: "\uC5B8\uB354\uCEE4\uBC84"
    m_Metadata:
      m_Items: []
  - m_Id: 7918957072302083
    m_Localized: "\uB300\uC2DC\uBCF4\uB4DC/\uCF55\uD54F"
    m_Metadata:
      m_Items: []
  - m_Id: 7918957072302084
    m_Localized: "\uACE0\uC804\uC555 \uCF00\uC774\uBE14"
    m_Metadata:
      m_Items: []
  - m_Id: 7918957072302085
    m_Localized: "\uC804\uC7A5 \uC81C\uC5B4 \uBAA8\uB4C8"
    m_Metadata:
      m_Items: []
  - m_Id: 7918957072302086
    m_Localized: "\uC13C\uD130 \uD130\uB110"
    m_Metadata:
      m_Items: []
  - m_Id: 7918957072302087
    m_Localized: "\uB9AC\uC5B4 \uC5D4\uB4DC \uD328\uB110"
    m_Metadata:
      m_Items: []
  - m_Id: 7918957072302088
    m_Localized: "\uACE0\uC804\uC555 \uBC30\uD130\uB9AC\uC758 \uC804\uB825\uC744
      \uD6C4\uB95C \uBAA8\uD130 \uBC0F \uAE30\uD0C0 \uACE0\uC804\uC555 \uBD80\uD488\uC73C\uB85C
      \uC548\uC804\uD558\uAC8C \uBD84\uBC30\uD558\uB294 \uC7A5\uCE58\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7918957072302089
    m_Localized: "\uCC28\uB7C9\uC758 \uACE8\uACA9\uC744 \uC774\uB8E8\uB294 \uAE30\uBCF8
      \uBF08\uB300\uB85C, \uBAA8\uB4E0 \uBD80\uD488\uC774 \uC7A5\uCC29\uB418\uB294
      \uAC00\uC7A5 \uD575\uC2EC\uC801\uC778 \uAD6C\uC870\uBB3C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7918957072302090
    m_Localized: "\uCC28\uB7C9 \uD558\uBD80\uC758 \uBD80\uD488\uC744 \uBCF4\uD638\uD558\uACE0
      \uACF5\uAE30 \uC800\uD56D\uC744 \uC904\uC774\uAE30 \uC704\uD574 \uD558\uB2E8\uC5D0
      \uBD80\uCC29\uB41C \uBCF4\uD638 \uB36E\uAC1C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7918957076496384
    m_Localized: "\uC6B4\uC804\uC11D \uC815\uBA74\uC758 \uACC4\uAE30\uD310, \uC624\uB514\uC624,
      \uC5D0\uC5B4\uCEE8 \uC1A1\uD48D\uAD6C \uB4F1\uC774 \uD3EC\uD568\uB41C \uC6B4\uC804\uC11D
      \uBAA8\uB4C8 \uC804\uCCB4\uB97C \uC758\uBBF8\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7918957076496385
    m_Localized: "\uBC30\uD130\uB9AC, \uC778\uBC84\uD130, \uBAA8\uD130 \uC0AC\uC774\uC5D0\uC11C
      \uB300\uC804\uB958\uB97C \uC804\uB2EC\uD558\uB294 \uC8FC\uD669\uC0C9 \uACE0\uC804\uC555
      \uBC30\uC120 \uBB49\uCE58\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7918957076496386
    m_Localized: "\uCC28\uB7C9\uC758 \uAC01\uC885 \uC804\uC790 \uC7A5\uCE58\uB97C
      \uC81C\uC5B4\uD558\uB294 ECU \uBC0F \uC800\uC804\uC555 \uBC30\uC120 \uC2DC\uC2A4\uD15C\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7918957076496387
    m_Localized: "\uC2E4\uB0B4 \uBC14\uB2E5 \uC911\uC559\uC5D0 \uC19F\uC544\uC624\uB978
      \uBD80\uBD84\uC73C\uB85C, \uBC30\uC120\uC774\uB098 \uB0C9\uAC01 \uD30C\uC774\uD504\uAC00
      \uC9C0\uB098\uAC00\uB294 \uD1B5\uB85C \uC5ED\uD560\uC744 \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7918957076496388
    m_Localized: "\uCC28\uB7C9\uC758 \uB9E8 \uB4B7\uBD80\uBD84 \uACE8\uACA9\uC73C\uB85C,
      \uD14C\uC77C\uB7A8\uD504\uC640 \uB4B7\uBC94\uD37C\uAC00 \uC7A5\uCC29\uB418\uB294
      \uBF08\uB300 \uBD80\uC704\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7925005610991616
    m_Localized: "\uCC28\uB7C9 \uB3C4\uC5B4"
    m_Metadata:
