  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: UI_Text_vi-VN
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: vi-VN
  m_SharedData: {fileID: 11400000, guid: 0e78f667002913f44a9bb59dbd92f6c8, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2016004460563
    m_Localized: "Theo t\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 2016004460562
    m_Localized: "Ti\u1EBFn \u0111\u1ED9 (%)"
    m_Metadata:
      m_Items: []
  - m_Id: 2016004460561
    m_Localized: "Danh s\xE1ch n\u1ED9i dung hu\u1EA5n luy\u1EC7n"
    m_Metadata:
      m_Items: []
  - m_Id: 2016004460560
    m_Localized: "B\u1EA1n c\xF3 mu\u1ED1n tho\xE1t kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 2016004460559
    m_Localized: "M\u1EADt kh\u1EA9u"
    m_Metadata:
      m_Items: []
  - m_Id: 2016004460558
    m_Localized: "ID ho\u1EB7c Email"
    m_Metadata:
      m_Items: []
  - m_Id: 2016004460557
    m_Localized: "Nh\u1EADp th\xF4ng tin \u0111\u0103ng nh\u1EADp"
    m_Metadata:
      m_Items: []
  - m_Id: 2016004460556
    m_Localized: "\u0110\u0103ng xu\u1EA5t"
    m_Metadata:
      m_Items: []
  - m_Id: 2016004460555
    m_Localized: "Tham gia ph\xF2ng"
    m_Metadata:
      m_Items: []
  - m_Id: 2016004460554
    m_Localized: "T\u1EA1o ph\xF2ng"
    m_Metadata:
      m_Items: []
  - m_Id: 2016004460553
    m_Localized: "kh\xE1ch"
    m_Metadata:
      m_Items: []
  - m_Id: 2016004460552
    m_Localized: "\u0110\u0103ng nh\u1EADp"
    m_Metadata:
      m_Items: []
  - m_Id: 2016004460551
    m_Localized: "Tho\xE1t"
    m_Metadata:
      m_Items: []
  - m_Id: 2016004460550
    m_Localized: "B\u1EAFt \u0111\u1EA7u"
    m_Metadata:
      m_Items: []
  - m_Id: 2016004460549
    m_Localized: "H\u1EE7y"
    m_Metadata:
      m_Items: []
  - m_Id: 2016004460548
    m_Localized: "X\xE1c nh\u1EADn"
    m_Metadata:
      m_Items: []
  - m_Id: 2016004460547
    m_Localized: "Ti\u1EBFng Vi\u1EC7t"
    m_Metadata:
      m_Items: []
  - m_Id: 2016004460546
    m_Localized: English
    m_Metadata:
      m_Items: []
  - m_Id: 2016004460545
    m_Localized: "\uD55C\uAD6D\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 2016004460544
    m_Localized: "C\xE0i \u0111\u1EB7t ng\xF4n ng\u1EEF"
    m_Metadata:
      m_Items: []
  - m_Id: 620075509534720
    m_Localized: "T\u1EA1o hu\u1EA5n luy\u1EC7n"
    m_Metadata:
      m_Items: []
  - m_Id: 620079724810240
    m_Localized: "| Ch\u1ECDn n\u1ED9i dung"
    m_Metadata:
      m_Items: []
  - m_Id: 620083583569920
    m_Localized: "| Ti\xEAu \u0111\u1EC1 ph\xF2ng"
    m_Metadata:
      m_Items: []
  - m_Id: 620110385172480
    m_Localized: "| S\u1ED1 ng\u01B0\u1EDDi t\u1ED1i \u0111a"
    m_Metadata:
      m_Items: []
  - m_Id: 620112222277632
    m_Localized: "T\u1EA1o"
    m_Metadata:
      m_Items: []
  - m_Id: 624165987733504
    m_Localized: "Ti\xEAu \u0111\u1EC1 n\u1ED9i dung"
    m_Metadata:
      m_Items: []
  - m_Id: 629558054932480
    m_Localized: "Vui l\xF2ng nh\u1EADp ti\xEAu \u0111\u1EC1 ph\xF2ng"
    m_Metadata:
      m_Items: []
  - m_Id: 650511870775296
    m_Localized: "L\xE0m m\u1EDBi"
    m_Metadata:
      m_Items: []
  - m_Id: 676216172105728
    m_Localized: "B\u1EA1n c\xF3 ch\u1EAFc ch\u1EAFn mu\u1ED1n \u0111\u0103ng xu\u1EA5t
      kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 704568639541248
    m_Localized: "Quay l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 716019399839744
    m_Localized: "ID ho\u1EB7c Email"
    m_Metadata:
      m_Items: []
  - m_Id: 716019408228352
    m_Localized: "M\u1EADt kh\u1EA9u"
    m_Metadata:
      m_Items: []
  - m_Id: 716019408228353
    m_Localized: "B\u1EA1n c\xF3 mu\u1ED1n tho\xE1t kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 716019408228354
    m_Localized: "Danh s\xE1ch n\u1ED9i dung \u0111\xE0o t\u1EA1o"
    m_Metadata:
      m_Items: []
  - m_Id: 716019408228355
    m_Localized: "M\u1EDBi nh\u1EA5t"
    m_Metadata:
      m_Items: []
  - m_Id: 716019408228356
    m_Localized: "Theo t\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 716019408228357
    m_Localized: "Chu\u1EA9n b\u1ECB"
    m_Metadata:
      m_Items: []
  - m_Id: 716019408228358
    m_Localized: "B\u1EAFt \u0111\u1EA7u \u0111\xE0o t\u1EA1o"
    m_Metadata:
      m_Items: []
  - m_Id: 716019408228359
    m_Localized: "Tham gia \u0111\xE0o t\u1EA1o"
    m_Metadata:
      m_Items: []
  - m_Id: 717643656646656
    m_Localized: "Phi\xEAn \u0111\xE0o t\u1EA1o"
    m_Metadata:
      m_Items: []
  - m_Id: 717643656646657
    m_Localized: "Ti\xEAu \u0111\u1EC1 n\u1ED9i dung"
    m_Metadata:
      m_Items: []
  - m_Id: 716530706468864
    m_Localized: "Tr\u1EA3i nghi\u1EC7m \u0111\xE3 k\u1EBFt th\xFAc."
    m_Metadata:
      m_Items: []
  - m_Id: 716527669792768
    m_Localized: "V\u1EC1 trang ch\u1EE7?"
    m_Metadata:
      m_Items: []
  - m_Id: 7892803586179072
    m_Localized: "C\u1ED9t l\xE1i"
    m_Metadata:
      m_Items: []
  - m_Id: 7892822175334400
    m_Localized: "H\u1EC7 th\u1ED1ng phanh"
    m_Metadata:
      m_Items: []
  - m_Id: 7892839640416256
    m_Localized: "C\u1EEDa xe"
    m_Metadata:
      m_Items: []
  - m_Id: 7892854559555584
    m_Localized: "B\xE1nh xe"
    m_Metadata:
      m_Items: []
  - m_Id: 7892506000310272
    m_Localized: "H\u1EC7 th\u1ED1ng l\xE0m m\xE1t v\xE0 \u0111i\u1EC1u h\xF2a"
    m_Metadata:
      m_Items: []
  - m_Id: 7892579811672064
    m_Localized: "\u0110\u1ED9ng c\u01A1 truy\u1EC1n \u0111\u1ED9ng c\u1EA7u tr\u01B0\u1EDBc"
    m_Metadata:
      m_Items: []
  - m_Id: 7892606323867648
    m_Localized: "H\u1EC7 th\u1ED1ng treo tr\u01B0\u1EDBc"
    m_Metadata:
      m_Items: []
  - m_Id: 7892633498763264
    m_Localized: "C\u1ED1p tr\u01B0\u1EDBc"
    m_Metadata:
      m_Items: []
  - m_Id: 7892656382885888
    m_Localized: "H\u1ED9p gi\u1EA3m t\u1ED1c"
    m_Metadata:
      m_Items: []
  - m_Id: 7892704705462272
    m_Localized: "N\u1EAFp ca-p\xF4"
    m_Metadata:
      m_Items: []
  - m_Id: 7892727824465920
    m_Localized: "\u0110\u1ED9ng c\u01A1 truy\u1EC1n \u0111\u1ED9ng c\u1EA7u sau"
    m_Metadata:
      m_Items: []
  - m_Id: 7892741581783040
    m_Localized: "B\u1ED9 ph\xE2n ph\u1ED1i \u0111i\u1EC7n ph\xEDa sau"
    m_Metadata:
      m_Items: []
  - m_Id: 7892769801060352
    m_Localized: "H\u1EC7 th\u1ED1ng treo sau"
    m_Metadata:
      m_Items: []
  - m_Id: 7892789027749888
    m_Localized: "Gh\u1EBF ng\u1ED3i"
    m_Metadata:
      m_Items: []
  - m_Id: 7918957072302080
    m_Localized: "B\u1ED9 pin cao \xE1p"
    m_Metadata:
      m_Items: []
  - m_Id: 716533395017728
    m_Localized: "B\xECnh \u1EAFc quy ph\u1EE5 12V"
    m_Metadata:
      m_Items: []
  - m_Id: 7892341214494720
    m_Localized: "C\u1ED5ng s\u1EA1c"
    m_Metadata:
      m_Items: []
  - m_Id: 7918957072302081
    m_Localized: "Khung g\u1EA7m"
    m_Metadata:
      m_Items: []
  - m_Id: 7918957072302082
    m_Localized: "T\u1EA5m ch\u1EAFn g\u1EA7m"
    m_Metadata:
      m_Items: []
  - m_Id: 7918957072302083
    m_Localized: "B\u1EA3ng \u0111i\u1EC1u khi\u1EC3n / Khoang l\xE1i"
    m_Metadata:
      m_Items: []
  - m_Id: 7918957072302084
    m_Localized: "C\xE1p cao \xE1p"
    m_Metadata:
      m_Items: []
  - m_Id: 7918957072302085
    m_Localized: "M\xF4-\u0111un \u0111i\u1EC1u khi\u1EC3n \u0111i\u1EC7n t\u1EED"
    m_Metadata:
      m_Items: []
  - m_Id: 7918957072302086
    m_Localized: "\u0110\u01B0\u1EDDng h\u1EA7m trung t\xE2m"
    m_Metadata:
      m_Items: []
  - m_Id: 7918957072302087
    m_Localized: "T\u1EA5m \u0111u\xF4i xe"
    m_Metadata:
      m_Items: []
  - m_Id: 7910223939977216
    m_Localized: "Th\xE0nh ph\u1EA7n l\xE1i c\u1ED1t l\xF5i truy\u1EC1n l\u1EF1c
      l\xE1i t\u1EEB v\xF4 l\u0103ng \u0111\u1EBFn h\u1ED9p s\u1ED1 v\xE0 b\xE1nh
      xe."
    m_Metadata:
      m_Items: []
  - m_Id: 7910093115441152
    m_Localized: "Thi\u1EBFt b\u1ECB phanh l\xE0m ch\u1EADm ho\u1EB7c d\u1EEBng xe
      \u0111ang chuy\u1EC3n \u0111\u1ED9ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7909806564786176
    m_Localized: "C\u1EEDa xe gi\xFAp h\xE0nh kh\xE1ch ra v\xE0o v\xE0 b\u1EA3o v\u1EC7
      ch\u1ED1ng l\u1EA1i c\xE1c t\xE1c \u0111\u1ED9ng t\u1EEB b\xEAn h\xF4ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7896409349636096
    m_Localized: "Th\xE0nh ph\u1EA7n h\u1ED7 tr\u1EE3 t\u1EA3i tr\u1ECDng c\u1EE7a
      xe v\xE0 truy\u1EC1n tr\u1EF1c ti\u1EBFp l\u1EF1c l\xE1i v\xE0 l\u1EF1c phanh
      xu\u1ED1ng m\u1EB7t \u0111\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 7911390669520896
    m_Localized: "B\u1ED9 \u0111i\u1EC1u khi\u1EC3n t\xEDch h\u1EE3p qu\u1EA3n l\xFD
      nhi\u1EC7t c\u1EE7a pin cao \xE1p v\xE0 \u0111\u1ED9ng c\u01A1, \u0111\u1ED3ng
      th\u1EDDi \u0111i\u1EC1u ch\u1EC9nh nhi\u1EC7t \u0111\u1ED9 trong nh\xE0."
    m_Metadata:
      m_Items: []
  - m_Id: 7911262181212160
    m_Localized: "\u0110\u1ED9ng c\u01A1 c\u1ED1t l\xF5i chuy\u1EC3n \u0111\u1ED5i
      n\u0103ng l\u01B0\u1EE3ng \u0111i\u1EC7n th\xE0nh c\u01A1 n\u0103ng \u0111\u1EC3
      t\u1EA1o l\u1EF1c k\xE9o cho b\xE1nh tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 7910642338578432
    m_Localized: "Thi\u1EBFt b\u1ECB h\u1EA5p th\u1EE5 ch\u1EA5n \u0111\u1ED9ng t\u1EEB
      m\u1EB7t \u0111\u01B0\u1EDDng m\xE0 b\xE1nh tr\u01B0\u1EDBc nh\u1EADn \u0111\u01B0\u1EE3c
      \u0111\u1EC3 c\u1EA3i thi\u1EC7n s\u1EF1 tho\u1EA3i m\xE1i khi l\xE1i xe v\xE0
      \u0111\u1ED9 \u1ED5n \u0111\u1ECBnh khi l\xE1i."
    m_Metadata:
      m_Items: []
  - m_Id: 7910504861876224
    m_Localized: "Kh\xF4ng gian ch\u1EE9a \u0111\u1ED3 ph\xEDa tr\u01B0\u1EDBc d\xE0nh
      ri\xEAng cho xe \u0111i\u1EC7n \u0111\u01B0\u1EE3c t\u1EA1o ra b\u1EB1ng c\xE1ch
      t\u1EADn d\u1EE5ng kh\xF4ng gian khoang \u0111\u1ED9ng c\u01A1 c\u1EE7a \u0111\u1ED9ng
      c\u01A1 \u0111\u1ED1t trong hi\u1EC7n c\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 7910571366760448
    m_Localized: "Thi\u1EBFt b\u1ECB t\u0103ng l\u1EF1c (m\xF4-men xo\u1EAFn) b\u1EB1ng
      c\xE1ch gi\u1EA3m t\u1ED1c \u0111\u1ED9 quay cao c\u1EE7a \u0111\u1ED9ng c\u01A1
      truy\u1EC1n \u0111\u1ED9ng v\xE0 truy\u1EC1n s\u1EE9c m\u1EA1nh t\u1EDBi c\xE1c
      b\xE1nh xe."
    m_Metadata:
      m_Items: []
  - m_Id: 7911842744188928
    m_Localized: "N\u1EAFp m\u1EDF che khoang \u0111\u1ED9ng c\u01A1 (ho\u1EB7c c\u1ED1p
      tr\u01B0\u1EDBc) \u1EDF ph\xEDa tr\u01B0\u1EDBc xe \u0111\u1EC3 b\u1EA3o v\u1EC7
      c\xE1c b\u1ED9 ph\u1EADn b\xEAn trong."
    m_Metadata:
      m_Items: []
  - m_Id: 7911934079352832
    m_Localized: "\u0110\u1ED9ng c\u01A1 truy\u1EC1n \u0111\u1ED9ng \u0111i\u1EC7n
      \xE1p cao n\u1EB1m \u1EDF ph\xEDa sau xe truy\u1EC1n l\u1EF1c d\u1EABn \u0111\u1ED9ng
      tr\u1EF1c ti\u1EBFp t\u1EDBi c\xE1c b\xE1nh sau."
    m_Metadata:
      m_Items: []
  - m_Id: 7918957072302088
    m_Localized: "Thi\u1EBFt b\u1ECB ph\xE2n ph\u1ED1i \u0111i\u1EC7n n\u0103ng t\u1EEB
      pin cao \xE1p t\u1EDBi \u0111\u1ED9ng c\u01A1 sau v\xE0 c\xE1c th\xE0nh ph\u1EA7n
      cao \xE1p kh\xE1c m\u1ED9t c\xE1ch an to\xE0n."
    m_Metadata:
      m_Items: []
  - m_Id: 7912243153420288
    m_Localized: "Thi\u1EBFt b\u1ECB h\u1EA5p th\u1EE5 ch\u1EA5n \u0111\u1ED9ng m\u1EB7t
      \u0111\u01B0\u1EDDng t\u1EEB b\xE1nh sau v\xE0 duy tr\xEC th\u0103ng b\u1EB1ng
      th\xE2n xe \u0111\u1EC3 mang l\u1EA1i s\u1EF1 \u1ED5n \u0111\u1ECBnh khi l\xE1i
      xe."
    m_Metadata:
      m_Items: []
  - m_Id: 7912492253134848
    m_Localized: "Gh\u1EBF n\u1ED9i th\u1EA5t \xF4 t\xF4 \u0111\u01B0\u1EE3c thi\u1EBFt
      k\u1EBF \u0111\u1EC3 h\xE0nh kh\xE1ch ng\u1ED3i an to\xE0n v\xE0 tho\u1EA3i
      m\xE1i."
    m_Metadata:
      m_Items: []
  - m_Id: 7913846019276800
    m_Localized: "Th\xE0nh ph\u1EA7n c\u1ED1t l\xF5i l\u01B0u tr\u1EEF l\u01B0\u1EE3ng
      l\u1EDBn n\u0103ng l\u01B0\u1EE3ng \u0111i\u1EC7n c\u1EA7n thi\u1EBFt cho ho\u1EA1t
      \u0111\u1ED9ng c\u1EE7a xe, bao g\u1ED3m nhi\u1EC1u t\u1EBF b\xE0o pin v\xE0
      h\u1EC7 th\u1ED1ng qu\u1EA3n l\xFD (BMS)."
    m_Metadata:
      m_Items: []
  - m_Id: 7913088951599104
    m_Localized: "Cung c\u1EA5p n\u0103ng l\u01B0\u1EE3ng cho h\u1EC7 th\u1ED1ng
      \u0111i\u1EC7n t\u1EED c\u1EE7a xe (chi\u1EBFu s\xE1ng, th\xF4ng tin gi\u1EA3i
      tr\xED, m\xF4-\u0111un \u0111i\u1EC1u khi\u1EC3n, v.v.) v\xE0 cung c\u1EA5p
      n\u0103ng l\u01B0\u1EE3ng ho\u1EA1t \u0111\u1ED9ng cho r\u01A1-le \u0111\u1EC3
      kh\u1EDFi \u0111\u1ED9ng h\u1EC7 th\u1ED1ng cao \xE1p."
    m_Metadata:
      m_Items: []
  - m_Id: 7913945499779072
    m_Localized: "Thi\u1EBFt b\u1ECB \u0111\u1EA7u v\xE0o \u0111\u1EC3 k\u1EBFt n\u1ED1i
      \u0111\u1EA7u n\u1ED1i b\u1ED9 s\u1EA1c b\xEAn ngo\xE0i \u0111\u1EC3 s\u1EA1c
      pin cao \xE1p."
    m_Metadata:
      m_Items: []
  - m_Id: 7918957072302089
    m_Localized: "Khung x\u01B0\u01A1ng c\u01A1 b\u1EA3n t\u1EA1o n\xEAn khung xe
      v\xE0 l\xE0 c\u1EA5u tr\xFAc c\u1ED1t l\xF5i nh\u1EA5t n\u01A1i t\u1EA5t c\u1EA3
      c\xE1c b\u1ED9 ph\u1EADn \u0111\u01B0\u1EE3c l\u1EAFp \u0111\u1EB7t."
    m_Metadata:
      m_Items: []
  - m_Id: 7918957072302090
    m_Localized: "T\u1EA5m b\u1EA3o v\u1EC7 g\u1EAFn d\u01B0\u1EDBi g\u1EA7m xe gi\xFAp
      b\u1EA3o v\u1EC7 c\xE1c b\u1ED9 ph\u1EADn ph\xEDa d\u01B0\u1EDBi v\xE0 gi\u1EA3m
      s\u1EE9c c\u1EA3n c\u1EE7a kh\xF4ng kh\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 7918957076496384
    m_Localized: "To\xE0n b\u1ED9 m\xF4-\u0111un gh\u1EBF l\xE1i bao g\u1ED3m c\u1EE5m
      \u0111\u1ED3ng h\u1ED3, \xE2m thanh v\xE0 c\u1EEDa gi\xF3 \u0111i\u1EC1u h\xF2a
      ph\xEDa tr\u01B0\u1EDBc gh\u1EBF l\xE1i."
    m_Metadata:
      m_Items: []
  - m_Id: 7918957076496385
    m_Localized: "B\xF3 d\xE2y cao \xE1p m\xE0u cam truy\u1EC1n d\xF2ng \u0111i\u1EC7n
      l\u1EDBn gi\u1EEFa pin, b\u1ED9 bi\u1EBFn t\u1EA7n v\xE0 \u0111\u1ED9ng c\u01A1."
    m_Metadata:
      m_Items: []
  - m_Id: 7918957076496386
    m_Localized: "H\u1EC7 th\u1ED1ng d\xE2y \u0111i\u1EC7n ECU v\xE0 \u0111i\u1EC7n
      \xE1p th\u1EA5p \u0111i\u1EC1u khi\u1EC3n c\xE1c thi\u1EBFt b\u1ECB \u0111i\u1EC7n
      t\u1EED kh\xE1c nhau trong xe."
    m_Metadata:
      m_Items: []
  - m_Id: 7918957076496387
    m_Localized: "Ph\u1EA7n nh\xF4 l\xEAn \u1EDF gi\u1EEFa s\xE0n n\u1ED9i th\u1EA5t
      \u0111\xF3ng vai tr\xF2 l\xE0 \u0111\u01B0\u1EDDng d\u1EABn d\xE2y \u0111i\u1EC7n
      ho\u1EB7c \u1ED1ng l\xE0m m\xE1t."
    m_Metadata:
      m_Items: []
  - m_Id: 7918957076496388
    m_Localized: "Khung x\u01B0\u01A1ng \u1EDF ph\xEDa sau xe, n\u01A1i l\u1EAFp
      \u0111\xE8n h\u1EADu v\xE0 c\u1EA3n sau."
    m_Metadata:
      m_Items: []
  - m_Id: 7925005610991616
    m_Localized: "C\u1EEDa xe"
    m_Metadata:
      m_Items: []
  - m_Id: 7925088528187392
    m_Localized: "C\u1EEDa xe"
    m_Metadata:
      m_Items: []
  - m_Id: 7925159764246528
    m_Localized: "C\u1EEDa xe"
    m_Metadata:
      m_Items: []
  - m_Id: 7925041816223744
    m_Localized: "B\xE1nh xe"
    m_Metadata:
      m_Items: []
  - m_Id: 7925135902851072
    m_Localized: "B\xE1nh xe"
    m_Metadata:
      m_Items: []
  - m_Id: 7925194425974784
    m_Localized: "B\xE1nh xe"
    m_Metadata:
      m_Items: []
  - m_Id: 7925327091810304
    m_Localized: "C\u1EEDa xe gi\xFAp h\xE0nh kh\xE1ch ra v\xE0o v\xE0 b\u1EA3o v\u1EC7
      ch\u1ED1ng l\u1EA1i c\xE1c t\xE1c \u0111\u1ED9ng t\u1EEB b\xEAn h\xF4ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7925350923845632
    m_Localized: "C\u1EEDa xe gi\xFAp h\xE0nh kh\xE1ch ra v\xE0o v\xE0 b\u1EA3o v\u1EC7
      ch\u1ED1ng l\u1EA1i c\xE1c t\xE1c \u0111\u1ED9ng t\u1EEB b\xEAn h\xF4ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7925378736275456
    m_Localized: "C\u1EEDa xe gi\xFAp h\xE0nh kh\xE1ch ra v\xE0o v\xE0 b\u1EA3o v\u1EC7
      ch\u1ED1ng l\u1EA1i c\xE1c t\xE1c \u0111\u1ED9ng t\u1EEB b\xEAn h\xF4ng."
    m_Metadata:
      m_Items: []
  - m_Id: 7926025292431360
    m_Localized: "Th\xE0nh ph\u1EA7n h\u1ED7 tr\u1EE3 t\u1EA3i tr\u1ECDng c\u1EE7a
      xe v\xE0 truy\u1EC1n tr\u1EF1c ti\u1EBFp l\u1EF1c l\xE1i v\xE0 l\u1EF1c phanh
      xu\u1ED1ng m\u1EB7t \u0111\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 7926125670514688
    m_Localized: "Th\xE0nh ph\u1EA7n h\u1ED7 tr\u1EE3 t\u1EA3i tr\u1ECDng c\u1EE7a
      xe v\xE0 truy\u1EC1n tr\u1EF1c ti\u1EBFp l\u1EF1c l\xE1i v\xE0 l\u1EF1c phanh
      xu\u1ED1ng m\u1EB7t \u0111\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 7926137070632960
    m_Localized: "Th\xE0nh ph\u1EA7n h\u1ED7 tr\u1EE3 t\u1EA3i tr\u1ECDng c\u1EE7a
      xe v\xE0 truy\u1EC1n tr\u1EF1c ti\u1EBFp l\u1EF1c l\xE1i v\xE0 l\u1EF1c phanh
      xu\u1ED1ng m\u1EB7t \u0111\u01B0\u1EDDng."
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000001
    m_Localized: "G\u0103ng tay c\xE1ch \u0111i\u1EC7n"
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000002
    m_Localized: "G\u0103ng tay b\u1EA3o h\u1ED9 l\xE0m t\u1EEB v\u1EADt li\u1EC7u
      c\xE1ch \u0111i\u1EC7n"
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000003
    m_Localized: "M\xE1y t\xEDnh b\u1EA3ng GDS"
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000005
    m_Localized: "C\u1EDD l\xEA va \u0111\u1EADp"
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000006
    m_Localized: "D\u1EE5ng c\u1EE5 \u0111i\u1EC7n s\u1EED d\u1EE5ng m\xF4-men xo\u1EAFn
      va \u0111\u1EADp m\u1EA1nh \u0111\u1EC3 v\u1EB7n ch\u1EB7t ho\u1EB7c th\xE1o
      nhanh bu l\xF4ng v\xE0 \u0111ai \u1ED1c."
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000007
    m_Localized: "H\u1ED9p kh\xF3a"
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000008
    m_Localized: "Thi\u1EBFt b\u1ECB kh\xF3a an to\xE0n d\xF9ng \u0111\u1EC3 ng\u0103n
      ch\u1EB7n vi\u1EC7c can thi\u1EC7p tr\xE1i ph\xE9p v\xE0o c\xE1c b\u1ED9 ph\u1EADn
      nguy hi\u1EC3m nh\u01B0 ph\xEDch c\u1EAFm d\u1ECBch v\u1EE5 pin cao \xE1p."
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000009
    m_Localized: "\u0110\u1ED3ng h\u1ED3 v\u1EA1n n\u0103ng"
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000011
    m_Localized: "Ch\xECa kh\xF3a th\xF4ng minh"
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000013
    m_Localized: "K\xEDnh che m\u1EB7t"
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000014
    m_Localized: "Thi\u1EBFt b\u1ECB b\u1EA3o v\u1EC7 m\u1EB7t trong su\u1ED1t \u0111\u01B0\u1EE3c
      \u0111eo \u0111\u1EC3 b\u1EA3o v\u1EC7 to\xE0n b\u1ED9 khu\xF4n m\u1EB7t khi
      l\xE0m vi\u1EC7c v\u1EDBi \u0111i\u1EC7n \xE1p cao ho\u1EB7c x\u1EED l\xFD
      h\xF3a ch\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000015
    m_Localized: "Gi\xE0y b\u1EA3o h\u1ED9 c\xE1ch \u0111i\u1EC7n"
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000016
    m_Localized: "Gi\xE0y b\u1EA3o h\u1ED9 l\xE0m t\u1EEB v\u1EADt li\u1EC7u c\xE1ch
      \u0111i\u1EC7n b\u1EA3o v\u1EC7 \u0111\xF4i ch\xE2n trong m\xF4i tr\u01B0\u1EDDng
      l\xE0m vi\u1EC7c c\xF3 nguy c\u01A1 \u0111i\u1EC7n gi\u1EADt."
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000017
    m_Localized: "K\xEDnh b\u1EA3o h\u1ED9"
    m_Metadata:
      m_Items: []
  - m_Id: 8487426867777536
    m_Localized: "Gi\u1EAFc c\u1EAFm d\u1ECBch v\u1EE5 (MSD)"
    m_Metadata:
      m_Items: []
  - m_Id: 8487431699615744
    m_Localized: "Gi\u1EAFc c\u1EAFm d\u1ECBch v\u1EE5 (MSD) l\xE0 m\u1ED9t thi\u1EBFt
      b\u1ECB an to\xE0n gi\xFAp ng\u1EAFt k\u1EBFt n\u1ED1i v\u1EADt l\xFD gi\u1EEFa
      pin cao \xE1p v\xE0 c\xE1c m\u1EA1ch \u0111i\u1EC7n c\xF2n l\u1EA1i c\u1EE7a
      xe. N\xF3 \u0111\u01B0\u1EE3c s\u1EED d\u1EE5ng \u0111\u1EC3 b\u1EA3o v\u1EC7
      k\u1EF9 thu\u1EADt vi\xEAn kh\u1ECFi b\u1ECB \u0111i\u1EC7n gi\u1EADt trong
      qu\xE1 tr\xECnh b\u1EA3o tr\xEC."
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000004
    m_Localized: "M\xE1y t\xEDnh b\u1EA3ng \u0111\u01B0\u1EE3c trang b\u1ECB h\u1EC7
      th\u1ED1ng ch\u1EA9n \u0111o\xE1n xe (GDS), d\xF9ng \u0111\u1EC3 ch\u1EA9n
      \u0111o\xE1n m\xE3 l\u1ED7i v\xE0 t\xECnh tr\u1EA1ng c\u1EE7a xe."
    m_Metadata:
      m_Items: []
  - m_Id: 8341724762554368
    m_Localized: "Thi\u1EBFt b\u1ECB \u0111o l\u01B0\u1EDDng c\xE1c \u0111\u1EB7c
      t\xEDnh \u0111i\u1EC7n nh\u01B0 \u0111i\u1EC7n \xE1p, d\xF2ng \u0111i\u1EC7n
      v\xE0 \u0111i\u1EC7n tr\u1EDF."
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000012
    m_Localized: "Ch\xECa kh\xF3a xe \u0111i\u1EC7n t\u1EED \u0111i\u1EC1u khi\u1EC3n
      m\u1EDF kh\xF3a, kh\u1EDFi \u0111\u1ED9ng v\xE0 m\u1EDF/\u0111\xF3ng c\u1EEDa
      xe qua t\xEDn hi\u1EC7u kh\xF4ng d\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 8000000000000018
    m_Localized: "K\xEDnh b\u1EA3o h\u1ED9 trong su\u1ED1t b\u1EA3o v\u1EC7 m\u1EAFt
      kh\u1ECFi m\u1EA3nh v\u1EE5n, b\u1EE5i v\xE0 h\xF3a ch\u1EA5t c\xF3 th\u1EC3
      ph\xE1t sinh trong qu\xE1 tr\xECnh l\xE0m vi\u1EC7c."
    m_Metadata:
      m_Items: []
  - m_Id: 12729850524155904
    m_Localized: "Vui l\xF2ng \u0111\u1EB7t ch\xECa kh\xF3a th\xF4ng minh v\xE0o
      h\u1ED9p kh\xF3a."
    m_Metadata:
      m_Items: []
  - m_Id: 12917184314032128
    m_Localized: "Vui l\xF2ng c\u1EAFm thi\u1EBFt b\u1ECB ch\u1EA9n \u0111o\xE1n
      GDS v\xE0o c\u1ED5ng OBD."
    m_Metadata:
      m_Items: []
  - m_Id: 12937531834843136
    m_Localized: "T\u1EA5m ch\u1EAFn d\u01B0\u1EDBi ph\xEDa tr\u01B0\u1EDBc"
    m_Metadata:
      m_Items: []
  - m_Id: 12937603033153536
    m_Localized: "T\u1EA5m ch\u1EAFn d\u01B0\u1EDBi ph\xEDa sau"
    m_Metadata:
      m_Items: []
  - m_Id: 12940721569480704
    m_Localized: "N\u1EAFp pin"
    m_Metadata:
      m_Items: []
  - m_Id: 13045550476247040
    m_Localized: "N\u1EAFp tr\u01B0\u1EDBc b\u1ED9 pin"
    m_Metadata:
      m_Items: []
  - m_Id: 13122058871980032
    m_Localized: "PRA (C\u1EE5m r\u01A1-le \u0111i\u1EC7n)"
    m_Metadata:
      m_Items: []
  - m_Id: 13124476296839168
    m_Localized: "Vui l\xF2ng th\xE1o PRA."
    m_Metadata:
      m_Items: []
  - m_Id: 13155526590939136
    m_Localized: "Bi\u1EC3n b\xE1o ng\u1EAFt \u0111i\u1EC7n cao \xE1p"
    m_Metadata:
      m_Items: []
  - m_Id: 13155581309829120
    m_Localized: "Vui l\xF2ng d\u1EF1ng bi\u1EC3n b\xE1o ng\u1EAFt \u0111i\u1EC7n
      cao \xE1p t\u1EA1i \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 13214248390443008
    m_Localized: "C\xE1p HV ph\xEDa tr\u01B0\u1EDBc"
    m_Metadata:
      m_Items: []
  - m_Id: 13214255701114880
    m_Localized: "C\xE1p HV ph\xEDa sau"
    m_Metadata:
      m_Items: []
  - m_Id: 13214284725698560
    m_Localized: "\u0110\u1EA7u n\u1ED1i ICCU"
    m_Metadata:
      m_Items: []
  - m_Id: 13214436899241984
    m_Localized: "\u0110\u1EA7u n\u1ED1i BMU"
    m_Metadata:
      m_Items: []
  - m_Id: 13214592654721024
    m_Localized: "C\xE1p n\u1ED1i \u0111\u1EA5t"
    m_Metadata:
      m_Items: []
  - m_Id: 13214657985200128
    m_Localized: "\u1ED0ng d\u1EABn n\u01B0\u1EDBc l\xE0m m\xE1t (\u0111\u1EA7u v\xE0o)"
    m_Metadata:
      m_Items: []
  - m_Id: 13214666306699264
    m_Localized: "\u1ED0ng d\u1EABn n\u01B0\u1EDBc l\xE0m m\xE1t (\u0111\u1EA7u ra)"
    m_Metadata:
      m_Items: []
  - m_Id: 13263269339414528
    m_Localized: "Vui l\xF2ng n\u1EAFm ho\u1EB7c nh\u1EA5p v\xE0o n\u1EAFp ca-p\xF4
      \u0111\u1EC3 m\u1EDF."
    m_Metadata:
      m_Items: []
  - m_Id: 13263272925544448
    m_Localized: "Vui l\xF2ng n\u1EAFm ho\u1EB7c nh\u1EA5p v\xE0o n\u1EAFp pin 12V
      \u0111\u1EC3 m\u1EDF."
    m_Metadata:
      m_Items: []
  - m_Id: 13270939660271616
    m_Localized: "B\u1ED9 n\xE2ng xe"
    m_Metadata:
      m_Items: []
  - m_Id: 13270942281711616
    m_Localized: "Nh\u1EA5n n\xFAt n\xE2ng \u0111\u1EC3 n\xE2ng xe l\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 13402677535391744
    m_Localized: "Vui l\xF2ng n\u1EAFm ho\u1EB7c nh\u1EA5p v\xE0o ph\xEDch c\u1EAFm
      d\u1ECBch v\u1EE5 \u0111\u1EC3 th\xE1o ra."
    m_Metadata:
      m_Items: []
  - m_Id: 13404517329092608
    m_Localized: "C\u1EF1c b\u1ED9 bi\u1EBFn t\u1EA7n ph\xEDa tr\u01B0\u1EDBc"
    m_Metadata:
      m_Items: []
  - m_Id: 13404573092364288
    m_Localized: "C\u1EF1c b\u1ED9 bi\u1EBFn t\u1EA7n ph\xEDa sau"
    m_Metadata:
      m_Items: []
  - m_Id: 13404652477956096
    m_Localized: "\u0110o \u0111i\u1EC7n \xE1p c\u1EE7a c\u1EF1c b\u1ED9 bi\u1EBFn
      t\u1EA7n ph\xEDa tr\u01B0\u1EDBc b\u1EB1ng \u0111\u1ED3ng h\u1ED3 v\u1EA1n
      n\u0103ng."
    m_Metadata:
      m_Items: []
  - m_Id: 13404669259366400
    m_Localized: "\u0110o \u0111i\u1EC7n \xE1p c\u1EE7a c\u1EF1c b\u1ED9 bi\u1EBFn
      t\u1EA7n ph\xEDa sau b\u1EB1ng \u0111\u1ED3ng h\u1ED3 v\u1EA1n n\u0103ng."
    m_Metadata:
      m_Items: []
  - m_Id: 13763514599030784
    m_Localized: "Vui l\xF2ng l\u1EAFp PRA m\u1EDBi."
    m_Metadata:
      m_Items: []
  - m_Id: 13763528649949184
    m_Localized: "Vui l\xF2ng \u0111\u1EADy n\u1EAFp b\u1ED9 pin l\u1EA1i."
    m_Metadata:
      m_Items: []
  - m_Id: 13763953520361472
    m_Localized: "N\u1EAFp tr\xEAn b\u1ED9 pin"
    m_Metadata:
      m_Items: []
  - m_Id: 13784560941219840
    m_Localized: "B\u1EA3n \u0111\u1ED3"
    m_Metadata:
      m_Items: []
  - m_Id: 13838078997774336
    m_Localized: "B\u1ED9 n\xE2ng pin"
    m_Metadata:
      m_Items: []
  - m_Id: 13838081434664960
    m_Localized: "H\xE3y c\u1EA7m b\u1ED9 n\xE2ng pin v\xE0 di chuy\u1EC3n \u0111\u1EBFn
      \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 14117528930537472
    m_Localized: "Nh\u1EA5n n\xFAt \u0111\u1EC3 n\xE2ng b\u1ED9 n\xE2ng l\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 14117998260572160
    m_Localized: "Nh\u1EA5n n\xFAt \u0111\u1EC3 h\u1EA1 b\u1ED9 n\xE2ng xu\u1ED1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 13888637431791616
    m_Localized: "V\u1ECB tr\xED n\u1ED1i \u0111\u1EA5t"
    m_Metadata:
      m_Items: []
  - m_Id: 13888640577519616
    m_Localized: "\u0110\u1EB7t \u0111\u1EA7u d\xF2 m\xE0u \u0111en v\xE0o \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 13888762476576768
    m_Localized: "\u0110o \u0111i\u1EC7n tr\u1EDF c\xE1ch \u0111i\u1EC7n BPA(+) (tr\u01B0\u1EDBc
      r\u01A1-le)"
    m_Metadata:
      m_Items: []
  - m_Id: 13888770366062592
    m_Localized: "\u0110o \u0111i\u1EC7n tr\u1EDF c\xE1ch \u0111i\u1EC7n BPA(-) (tr\u01B0\u1EDBc
      r\u01A1-le)"
    m_Metadata:
      m_Items: []
  - m_Id: 13888774958825472
    m_Localized: "\u0110o \u0111i\u1EC7n tr\u1EDF c\xE1ch \u0111i\u1EC7n b\u1ED9
      bi\u1EBFn t\u1EA7n(+) (sau r\u01A1-le)"
    m_Metadata:
      m_Items: []
  - m_Id: 13888779287347200
    m_Localized: "\u0110o \u0111i\u1EC7n tr\u1EDF c\xE1ch \u0111i\u1EC7n b\u1ED9
      bi\u1EBFn t\u1EA7n(-) (sau r\u01A1-le)"
    m_Metadata:
      m_Items: []
  - m_Id: 14113235846483968
    m_Localized: "\u0110\u1EB7t \u0111\u1EA7u d\xF2 m\xE0u \u0111\u1ECF v\xE0o \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 14113238518255616
    m_Localized: "\u0110\u1EB7t \u0111\u1EA7u d\xF2 m\xE0u \u0111\u1ECF v\xE0o \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 14113240200171520
    m_Localized: "\u0110\u1EB7t \u0111\u1EA7u d\xF2 m\xE0u \u0111\u1ECF v\xE0o \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 14113241403936768
    m_Localized: "\u0110\u1EB7t \u0111\u1EA7u d\xF2 m\xE0u \u0111\u1ECF v\xE0o \u0111\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 14121061645996032
    m_Localized: "N\u01B0\u1EDBc l\xE0m m\xE1t"
    m_Metadata:
      m_Items: []
  - m_Id: 14121063323717632
    m_Localized: "Vui l\xF2ng b\u1ED5 sung n\u01B0\u1EDBc l\xE0m m\xE1t."
    m_Metadata:
      m_Items: []
  - m_Id: 15098284411011072
    m_Localized: "\u0110ang x\u1EA3 \u0111i\u1EC7n \xE1p d\u01B0... {0:F1}s"
    m_Metadata:
      m_Items: []
  - m_Id: 15098386617810944
    m_Localized: "\u0110\xE3 x\u1EA3 \u0111i\u1EC7n xong. Vui l\xF2ng th\u1EF1c hi\u1EC7n
      b\u01B0\u1EDBc ti\u1EBFp theo."
    m_Metadata:
