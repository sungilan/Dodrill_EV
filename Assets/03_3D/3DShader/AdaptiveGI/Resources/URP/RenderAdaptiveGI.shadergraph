    },
    "m_Name": "UnpackGBufferNormal (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -892.0001220703125,
            "y": 527.2000732421875,
            "width": 304.00006103515627,
            "height": 93.5999755859375
        }
